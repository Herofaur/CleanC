<Window x:Class="CleanC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:CleanC.Core.Models;assembly=CleanC.Core"
        xmlns:converters="clr-namespace:CleanC.App.Converters"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="CleanC - 磁盘分析与清理助手" Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}" FontFamily="Microsoft YaHei UI"
        Closing="Window_Closing">
    <Window.Resources>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter" />
        <converters:CleanupLevelConverter x:Key="CleanupLevelConverter" />
        <HierarchicalDataTemplate DataType="{x:Type models:DirectoryEntry}" ItemsSource="{Binding Children}">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" />
                <TextBlock Grid.Column="1" Margin="18,0,8,0" Foreground="{StaticResource MutedBrush}"
                           Text="{Binding Size, Converter={StaticResource ByteSizeConverter}}" />
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17233D" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" Background="#2F6FED" CornerRadius="11" Margin="0,0,14,0">
                        <TextBlock Text="C" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="CleanC" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="安全优先的 Windows 磁盘分析与清理助手" Foreground="#AFC0DF" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#243451" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock Text="v0.1 · .NET 10" Foreground="#C8D4EB" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,18,24,0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="扫描位置" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,14,0" />
                <TextBox Grid.Column="1" Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10,8"
                         BorderBrush="#D8DEE9" VerticalContentAlignment="Center" IsEnabled="{Binding IsNotScanning}" />
                <Button Grid.Column="2" Content="选择文件夹" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        IsEnabled="{Binding IsNotScanning}" Click="Browse_Click" />
                <Button Grid.Column="3" Content="开始扫描" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        IsEnabled="{Binding IsNotScanning}" Click="StartScan_Click" />
                <Button Grid.Column="4" Content="停止" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        IsEnabled="{Binding IsScanning}" Click="CancelScan_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding DriveTitle}" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding DriveUsageText}" FontSize="18" FontWeight="SemiBold" Margin="0,8" />
                    <ProgressBar Value="{Binding DriveUsedPercent}" Maximum="100" Height="7" Foreground="#2F6FED" Background="#E7ECF5" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="已扫描容量" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding ScannedBytes, Converter={StaticResource ByteSizeConverter}}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,3" />
                    <TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="{Binding ScannedFiles, StringFormat={}{0:N0}}"/><Run Text=" 个文件"/></TextBlock>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="潜在可清理" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding PotentialCleanupBytes, Converter={StaticResource ByteSizeConverter}}" Foreground="#E05A33" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,3" />
                    <TextBlock Text="包含需人工确认的项目" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="扫描统计" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,8,0,3"><Run Text="{Binding ScannedDirectories, StringFormat={}{0:N0}}"/><Run Text=" 个目录"/></TextBlock>
                    <TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="耗时 "/><Run Text="{Binding ElapsedText}"/><Run Text=" · 跳过 "/><Run Text="{Binding AccessErrorCount}"/></TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="24,0,24,14" Style="{StaticResource Card}" Padding="0">
            <TabControl BorderThickness="0" Background="Transparent" Padding="8">
                <TabItem Header="容量概览">
                    <Grid Margin="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="6,4,0,12">
                            <TextBlock Text="占用最大的目录" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="按扫描范围内的总占用排序；百分比相对于本次扫描总量。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding LargestDirectories}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="目录" Binding="{Binding Name}" Width="220" />
                                <DataGridTextColumn Header="完整路径" Binding="{Binding FullPath}" Width="*" />
                                <DataGridTemplateColumn Header="占比" Width="180">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Grid Margin="4,8"><ProgressBar Value="{Binding SharePercent}" Maximum="100" Height="10" Foreground="#5A84E8" Background="#E8EDF6"/><TextBlock Text="{Binding SharePercent, StringFormat={}{0:0.0}%}" HorizontalAlignment="Right" Margin="0,-6,0,0" FontSize="11"/></Grid>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="大小" Binding="{Binding Size, Converter={StaticResource ByteSizeConverter}}" Width="110" />
                                <DataGridTextColumn Header="文件" Binding="{Binding FileCount, StringFormat={}{0:N0}}" Width="90" />
                                <DataGridTemplateColumn Header="" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="定位" Tag="{Binding FullPath}" Click="Reveal_Click" Style="{StaticResource SecondaryButton}" Padding="10,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="目录树">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="展开目录查看各部分占用；重解析点与符号链接会被跳过，避免重复统计。" Foreground="{StaticResource MutedBrush}" Margin="4,3,0,12" />
                        <TreeView Grid.Row="1" ItemsSource="{Binding DirectoryRoots}" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" BorderThickness="0" Padding="6" />
                    </Grid>
                </TabItem>

                <TabItem Header="最大文件">
                    <Grid Margin="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="显示本次扫描中最大的 2,000 个文件。此页面只做分析，不会自动选择删除。" Foreground="{StaticResource MutedBrush}" Margin="6,4,0,12" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding LargestFiles}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="230" />
                                <DataGridTextColumn Header="完整路径" Binding="{Binding FullPath}" Width="*" />
                                <DataGridTextColumn Header="大小" Binding="{Binding Size, Converter={StaticResource ByteSizeConverter}}" Width="110" />
                                <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                                <DataGridTemplateColumn Header="" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="定位" Tag="{Binding FullPath}" Click="Reveal_Click" Style="{StaticResource SecondaryButton}" Padding="10,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="清理建议">
                    <Grid Margin="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Background="#FFF7E8" BorderBrush="#F3D49A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="2,2,2,12">
                            <TextBlock Foreground="#7B5514" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="安全说明："/><Run Text="建议清理项会默认勾选；下载文件、安装包和超大文件必须手动勾选。所有删除均进入回收站，系统关键路径会被再次拦截。"/></TextBlock>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding CleanupGroups}" SelectedItem="{Binding SelectedCleanupGroup}" BorderBrush="#E2E7EF" BorderThickness="1">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid Margin="8" Width="270">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                            <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Background="#E8F0FF"><TextBlock Text="{Binding Level, Converter={StaticResource CleanupLevelConverter}}" Foreground="#315FAE" FontSize="11"/></Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                                        <TextBlock Grid.Row="2" Text="{Binding Reason}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11" />
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="2,0,2,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding SelectedCleanupGroup.Title}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding SelectedCleanupGroup.SelectedSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                                    <Button Grid.Column="1" Content="全选本组" Click="SelectGroup_Click" Style="{StaticResource SecondaryButton}" Margin="8,0" />
                                    <Button Grid.Column="2" Content="清空选择" Click="ClearGroup_Click" Style="{StaticResource SecondaryButton}" />
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedCleanupGroup.Candidates}" IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="选择" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="210" IsReadOnly="True" />
                                        <DataGridTextColumn Header="路径" Binding="{Binding FullPath}" Width="*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="大小" Binding="{Binding Size, Converter={StaticResource ByteSizeConverter}}" Width="105" IsReadOnly="True" />
                                        <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd}}" Width="105" IsReadOnly="True" />
                                        <DataGridTemplateColumn Header="" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="定位" Tag="{Binding FullPath}" Click="Reveal_Click" Style="{StaticResource SecondaryButton}" Padding="9,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2" Margin="2,12,2,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="清理前会显示最终确认；清理失败的占用文件会保留在列表中。" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="清理已选择项目" Style="{StaticResource PrimaryButton}" Click="CleanSelected_Click" IsEnabled="{Binding IsNotScanning}" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="4" Background="White" BorderBrush="#E2E7EF" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#3AA76D" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="20,0" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="2" Width="120" Height="6" IsIndeterminate="{Binding IsScanning}" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
